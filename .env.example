# ===== MedX =====
MEDX_BASE_URL=https://medx65-v65teste.azurewebsites.net
MEDX_TOKEN_INTEGRACAO=
MEDX_MEDICO_CAMPO=Nome

# ===== Mais Chat (broker Meta Cloud API) =====
MAISCHAT_BASE_URL=https://api.maischat.io/v3
MAISCHAT_BROKER=wppCloudAPI
# appId = Phone Number ID do canal (de GET /brokers)
MAISCHAT_APP_ID=
# source = número do canal em E.164 (ex.: 558000708000)
MAISCHAT_SOURCE=
# token do Graph API (Meta) do canal
MAISCHAT_META_TOKEN=
# opcional: chave de autenticação da API REST do Mais Chat, se o tenant exigir
MAISCHAT_API_KEY=
# nome do template aprovado na Meta (criar antes de usar)
MAISCHAT_TEMPLATE_NOME=
MAISCHAT_TEMPLATE_VARIAVEIS=nome,medico,data,hora
MAISCHAT_TEMPLATE_IDIOMA=pt_BR

# ===== Agendamento / ACK =====
CRON_HORARIO=0 8 * * *
ACK_PASSE1_MIN=5
ACK_PASSE2_MIN=60
TZ=America/Sao_Paulo

# ===== Dashboard / servidor =====
RUN_TOKEN=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
SESSION_SECRET=
PORT=3000
SQLITE_PATH=./data/envios.db
