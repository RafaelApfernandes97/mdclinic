# ===== MedX =====
MEDX_BASE_URL=https://medx65-v65teste.azurewebsites.net
MEDX_TOKEN_INTEGRACAO=
# campo de nome do médico no retorno do GetUsuariosAgenda (real: "Usuario")
MEDX_MEDICO_CAMPO=Usuario

# ===== NetVacinas (opcional) =====
# O token é usado exclusivamente no backend. Sem ele, o painel MedX continua disponível.
NETVACINAS_GRAPHQL_URL=https://api.netvacinas.com.br/graphql
NETVACINAS_TOKEN=BkAiyr1-fqZ5M9SgkI6eOh3_lfBezOGwcrqRgY-yQjw
# Nome mostrado no template de confirmação quando a variável "medico" for usada.
NETVACINAS_NOME_AGENDA=NetVacinas

# ===== Mais Chat (broker Meta Cloud API) =====
MAISCHAT_BASE_URL=https://api.maischat.io/v3
MAISCHAT_BROKER=wppCloudAPI
# appId = Phone Number ID do canal (de GET /brokers)
MAISCHAT_APP_ID=
# source = número do canal em E.164 (ex.: 558000708000)
MAISCHAT_SOURCE=
# token do Graph API (Meta) do canal
MAISCHAT_META_TOKEN=
# opcional: chave de autenticação da API REST do Mais Chat, se o tenant exigir
MAISCHAT_API_KEY=
# nome do template aprovado na Meta (criar antes de usar)
MAISCHAT_TEMPLATE_NOME=
# ordem das variáveis posicionais do template; chaves disponíveis:
#   nome (paciente), medico (sem título), data (dd/mm/aaaa), hora (HH:MM),
#   dia ("Terça-feira 14/07"), hora_curta ("14" ou "14:30")
MAISCHAT_TEMPLATE_VARIAVEIS=nome,dia,hora_curta
MAISCHAT_TEMPLATE_IDIOMA=pt_BR

# ===== Agendamento / ACK =====
CRON_HORARIO=0 8 * * *
ACK_PASSE1_MIN=5
ACK_PASSE2_MIN=60
TZ=America/Sao_Paulo
# DRY_RUN=true: o job captura a agenda e mostra no dashboard, mas NÃO envia
# mensagens (modo teste). DRY_RUN=false (ou ausente): envia normalmente.
DRY_RUN=false
# DEBUG=true: logs detalhados do envio HTTP no Mais Chat (sem expor o token).
# Os logs do envio manual ([envio-manual]) saem sempre.
DEBUG=false

# ===== Dashboard / servidor =====
RUN_TOKEN=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
SESSION_SECRET=
PORT=5300
SQLITE_PATH=./data/envios.db


# Janela do webhook de confirmação; cobre o lembrete do próximo dia útil. Default 4.
JANELA_CONFIRMACAO_DIAS=4

# Agendas com envio em massa habilitado no dashboard (slugs separados por vírgula;
# aceita também o nome completo, ex.: "Dra Marina de Deus"). Default: dramarinadedeus.
ENVIO_MASSA_MEDICOS=dramarinadedeus
